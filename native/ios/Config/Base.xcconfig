// Build settings shared by every configuration. Everything here is safe to
// commit. Credentials and per-developer values go in Secrets.xcconfig, which
// is gitignored; copy Secrets.example.xcconfig to create it. CI writes the
// same file from repository secrets.

PULLUP_BUNDLE_ID = app.pullup.ios
PULLUP_TEAM_ID =

// Supabase project host WITHOUT the scheme (xcconfig treats "//" as a
// comment), e.g. abcd1234.supabase.co. Empty = the app shows "Server not
// configured" and offers labelled demo data.
PULLUP_SUPABASE_HOST =
PULLUP_SUPABASE_ANON_KEY =
// Which project the host above is: staging or production. Shown in
// Settings > About so a tester can tell which backend a build talks to.
PULLUP_BACKEND_ENVIRONMENT =

// Public pages (docs/public, rendered by GitHub; docs/PUBLIC_PAGES_RELEASE.md),
// WITHOUT the scheme: xcconfig reads "//" as a comment, and the app adds
// https (LegalLinks). Shown in Settings > About; the privacy policy also
// with Pull Up Pro. Every build gets these. A GitHub environment variable
// of the same name (TestFlight workflow) overrides one only when it is set;
// an empty value = that link isn't shown.
PULLUP_PRIVACY_POLICY = github.com/AaravJit/pull-up/blob/main/docs/public/privacy.md
PULLUP_SUPPORT_URL = github.com/AaravJit/pull-up/blob/main/docs/public/support.md
PULLUP_TERMS_URL = github.com/AaravJit/pull-up/blob/main/docs/public/terms.md
PULLUP_COMMUNITY_URL = github.com/AaravJit/pull-up/blob/main/docs/public/community.md

// Whether Pull Up Pro is on sale in this build. NO hides every Pro entry
// point (people who already have Pro keep it and still see it). Set YES once
// the subscriptions are submitted with the version.
PULLUP_PRO_OFFERED = NO

// eBay Partner Network campaign id (10 digits) for parts-finder links.
// Empty = plain eBay links with no affiliate parameters or disclosure.
PULLUP_EPN_CAMPAIGN_ID =

// Swap to PullUp/PullUp-CarPlay.entitlements once Apple grants the CarPlay
// Driving Task entitlement (see docs/CARPLAY.md).
PULLUP_ENTITLEMENTS = PullUp/PullUp.entitlements

#include? "Secrets.xcconfig"
